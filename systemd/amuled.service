[Unit]
Description=aMule daemon (eD2k + Kad)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/home/pi/Downloads

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi
Environment=HOME=/home/pi
Environment=MALLOC_ARENA_MAX=2
UMask=0077
NoNewPrivileges=true
# Foreground mode (--full-daemon would double-fork); --disable-fatal keeps
# assertion dialogs from blocking systemd's auto-restart (see amuled(1)).
ExecStart=/opt/aMule/amuled --disable-fatal
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
# P2P daemon: allow many concurrent connections
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
