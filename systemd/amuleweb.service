[Unit]
Description=aMule web interface (amuleweb)
After=network-online.target amuled.service
Wants=network-online.target
Requires=amuled.service
PartOf=amuled.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi
Environment=HOME=/home/pi
UMask=0077
NoNewPrivileges=true
# Reads ~/.aMule/remote.conf, no arguments needed. Create it once with:
#   amuleweb -P <EC password> -A <web admin password> -w
ExecStart=/opt/aMule/amuleweb
# The legacy client can exit successfully when EC is not ready yet.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
